# Platform API — OCR, DB, ABHA, summaries, follow-ups (backend/)
# Copy: cp backend/.env.example backend/.env
# Never put Vite/browser secrets here. Never commit .env.

# --- Database (required) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
# Recycle idle pooled connections before hosted Postgres drops them (seconds).
DATABASE_POOL_MAX_IDLE=180
DATABASE_POOL_MAX_LIFETIME=1800

# --- OCR ---
OCR_PROVIDER=aws
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Or use a named profile instead of keys:
# AWS_PROFILE=medikiosk

# --- RAG / embeddings (optional until P5) ---
GROQ_API_KEY=

# --- ABDM / ABHA (mock OK until real integration) ---
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# --- Staff / doctor console (optional; empty = open stub) ---
STAFF_TOKEN=

# --- Voice (same process serves /api/offer) ---
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# --- Production (Railway) ---
# Comma-separated browser origins allowed to call the API
# CORS_ORIGINS=https://your-client.up.railway.app
# TURN required for WebRTC audio off localhost
# TURN_URLS=turn:your.turn.server:3478,turns:your.turn.server:443
# TURN_USERNAME=
# TURN_CREDENTIAL=

# --- Server ---
# HOST=0.0.0.0
# On Railway do NOT hardcode PORT — the platform injects it.
# PORT=8000

